{
  "name": "headshot-haven-app",
  "productName": "Headshot Haven",
  "version": "1.0.0",
  "description": "Headshot Haven desktop app: a free FPS aim trainer.",
  "author": "Abdi Rahman Suufi",
  "license": "ISC",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app -c cyan,yellow \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.abdisuufi.headshothaven",
    "productName": "Headshot Haven",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Headshot Haven"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
